[Unit]
Description=FastAPI seguros medicos
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/api-seguros-mlops
ExecStart=/home/ubuntu/miniconda3/envs/fastapi/bin/uvicorn main:app --host 0.0.0.0 --port 8000

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
